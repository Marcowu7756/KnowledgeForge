# LLM provider — dual-track (choose one; both are first-class):
#   local:  ollama
#   cloud:  openai | gemini | deepseek
# Switching provider does not change KO classification; it changes which KOs
# may enter compose (restricted → local track only by default).
LLM_PROVIDER=ollama
LOCAL_FIRST=true

# OpenAI (optional cloud fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (optional cloud fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek (optional cloud fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama (local LLM — run: ollama pull qwen2.5:14b)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Optional knowledge index (default on)
INDEX_ENABLED=true

# ---- Local models (models/ under project root) ----
# Pull with: python main.py models pull
WHISPER_MODEL=D:\KnowledgeForge\models\faster-whisper-medium
EMBED_MODEL_PATH=D:\KnowledgeForge\models\bge-small-zh-v1.5
# Voice-clone TTS (F5-TTS + vocos). Record sample: python main.py voice record --name me
TTS_ENGINE=clone
TTS_MODEL_PATH=D:\KnowledgeForge\models\F5-TTS
VOCOS_MODEL_PATH=D:\KnowledgeForge\models\vocos-mel-24khz
TTS_VOICE_NAME=
TTS_NFE_STEP=16
# HuggingFace cache pinned under models/ (offline after pull)
HF_HOME=D:\KnowledgeForge\models\.hf
PADDLEX_CACHE_HOME=D:\KnowledgeForge\models\paddlex
PIX2TEX_MODEL_PATH=D:\KnowledgeForge\models\pix2tex
PADDLE_OCR_LANG=ch
PADDLE_PDX_MODEL_SOURCE=bos
# Phase 3 TTS (Piper / CosyVoice — install separately)
# TTS_MODEL_PATH=D:\KnowledgeForge\models\piper

# After models are pulled, block runtime Hub downloads:
HF_HUB_OFFLINE=1
# Mirror only used during `models pull`, not normal pipeline runs:
# HF_ENDPOINT=https://hf-mirror.com

WHISPER_LANGUAGE=zh

# Access ceiling for retrieve (public|internal|restricted|secret). Default keeps
# proprietary SETV/FactorLib/AShareLib KOs searchable locally.
# KF_ACCESS_MAX_RETRIEVE=restricted
# KF_ACCESS_INCLUDE_SECRET=1
# Access governance audit (append-only JSONL under data/audit/access/)
# KF_ACCESS_AUDIT=1

# Twitter/X API v2 (optional — single tweet URLs work without a token)
TWITTER_BEARER_TOKEN=
